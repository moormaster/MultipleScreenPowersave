{
	"blackWindowService": {
		"physicalMonitors": [
			/* Use white fullscreen image to save power on second lcd monitor (index starts at 0)
			 * { "index": 1, "invertBackgroundColor": true },
			 */

			/* Its also possible to match monitor by description
			 * { "description": ".*Samsung.*", ... },
			 */

			/* ... or by deviceId
			 * { "deviceId": "MONITOR\\\\SAM07AF\\\\.*", ... },
			 */

			/* ... or by linuxBacklightDevice
			 * { "linuxBacklightDevice": "intel_backlight", ... },
			 */

			/* ... or by linuxI2cDevice
			 * { "deviceId": "i2c-19", ... },
			 */

			/* ... or by wmiInstanceName
			 * { "wmiInstanceName": "DISPLAY\\\\SAM.*", ... },
			 */
		]
	},

	"hostedBackgroundService": {
		// delay in milliseconds between attempts to turn off unsed monitors
		"sleepTimeMs": 1000
	},

	"blacklist": {
		"displayMonitors": [
			/* Blacklist primary monitor
			 * { "isPrimary": true }
			 */
		],

		"physicalMonitors": [
			/* Blacklist second monitor (index starts at 0)
			 * { "index": 1, "invertBackgroundColor": true },
			 */

			/* Its also possible to match monitor by description
			 * { "description": ".*Samsung.*" },
			 */

			/* ... or by deviceId
			 * { "deviceId": "MONITOR\\\\SAM07AF\\\\.*" },
			 */

			/* ... or by linuxBacklightDevice
			 * { "linuxBacklightDevice": "intel_backlight" },
			 */

			/* ... or by linuxI2cDevice
			 * { "deviceId": "i2c-19" },
			 */

			/* ... or by wmiInstanceName
			 * { "wmiInstanceName": "DISPLAY\\\\SAM.*" },
			 */
		],

		/* Define which windows will be blacklisted.
		 * A monitor showing no or only windows that are blacklisted will be
		 * considered as "unused" and will be turned off
		 */
		"windows": [
			{
				"processName": "explorer",
				"windowTitle": "^(|Program Manager)$"
			},
			{ "processName": "TextInputHost" }
		]
	},

	// Logger options, see https://github.com/serilog/serilog-settings-configuration
	"Serilog": {
		"MinimumLevel": {
			"Default": "Debug",
			"Override": {
				"Microsoft.AspNetCore.Hosting": "Warning"
			}
		},
		"WriteTo": {
			"ConsoleLog": {
				"Name": "Console",
				"Args": {
					"restrictedToMinimumLevel": "Information"
				}
			},
			/*
			"DebugLogFile": {
				"Name": "File",
				"Args": {
					"path": "MultipleScreenPowersave.debug_.log",
					"restrictedToMinimumLevel": "Debug",
					"retainedFileCountLimit": 12,
					"rollingInterval": "Month",
					"rollOnFileSizeLimit": true
				}
			},
			*/
			"ErrorLogFile": {
				"Name": "File",
				"Args": {
					"path": "MultipleScreenPowersave.error_.log",
					"restrictedToMinimumLevel": "Error",
					"retainedFileCountLimit": 12,
					"rollingInterval": "Month"
				}
			}
		}
	}
}
