{
	"blackWindowService": {
		"physicalMonitors": []
	},

	"hostedBackgroundService": {
		"sleepTimeMs": 1000
	},

	"blacklist": {
		"displayMonitors": [
			{ "isPrimary": true }
		],

		"windows": [
			{
				"processName": "explorer",
				"windowTitle": "^(|Program Manager)$"
			},
			{ "processName": "TextInputHost" }
		]
	},
	"Serilog": {
		"MinimumLevel": {
			"Default": "Debug",
			"Override": {
				"Microsoft.AspNetCore.Hosting": "Warning"
			}
		},
		"WriteTo": {
			"ConsoleLog": {
				"Name": "Console",
				"Args": {
					"restrictedToMinimumLevel": "Information"
				}
			},
			/*
			"DebugLogFile": {
				"Name": "File",
				"Args": {
					"path": "MultipleScreenPowersave.debug_.log",
					"restrictedToMinimumLevel": "Debug",
					"retainedFileCountLimit": 12,
					"rollingInterval": "Month",
					"rollOnFileSizeLimit": true
				}
			},
			*/
			"ErrorLogFile": {
				"Name": "File",
				"Args": {
					"path": "MultipleScreenPowersave.error_.log",
					"restrictedToMinimumLevel": "Error",
					"retainedFileCountLimit": 12,
					"rollingInterval": "Month"
				}
			}
		}
	}
}